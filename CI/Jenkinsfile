pipeline {
    agent any

    environment {
        DOCKERHUB_CREDS=credentials('docker')
        LC_ALL = "en_US.UTF-8"
        LANG    = "en_US.UTF-8"
        LANGUAGE = "en_US.UTF-8"
    }

options {
        timestamps()
        skipDefaultCheckout(true)
	}
    stages {
        stage('Clone github repository') {
            steps {
                cleanWs()
                bat 'chcp 65001 && git clone -b main https://github.com/Nikita-123-orange/devops-laba1.git'
				}
			}

        stage('Checkout repo dir') {
            steps {
                bat 'chcp 65001 && cd devops-laba1 && dir'
				}
			}

        stage('Login'){
            steps{
                //withCredentials([usernamePassword(credentialsId: 'devops-laba1', passwordVariable: 'DOCKER_REGISTRY_PWD', usernameVariable: 'DOCKER_REGISTRY_USER')]){
                //bat 'chcp 65001 && echo %DOCKER_REGISTRY_PWD% | docker login -u %DOCKER_REGISTRY_USER% --password-stdin'}
                //bat 'chcp 65001 && echo %DOCKERHUB_CREDS_PSW% | docker login -u %DOCKERHUB_CREDS_USR% --password-stdin'
                bat 'chcp 65001 && docker login -u %DOCKERHUB_CREDS_USR% -p %DOCKERHUB_CREDS_PSW%'
                }
            }

        stage('Create and run docker container') {
            steps {
                script {
                    try {
                        bat 'chcp 65001 && cd devops-laba1 && docker-compose build'
                        }

                    finally {
                    bat '''
                        chcp 65001
                        cd devops-laba1
                        docker-compose up -d
                        '''
                        }
				    }
                }
            }

        // use for multi containers:
        //docker exec %containerId% cd app && coverage run src/unit_tests/test_preprocess.py && coverage run -a src/unit_tests/test_training.py && coverage report -m
        //use for single container (with auth):
        //docker run --name devops-laba1_web_1 cd app && coverage run src/unit_tests/test_preprocess.py && coverage run -a src/unit_tests/test_training.py && coverage report -m

        stage('Checkout container logs') {
            steps {
                dir("devops-laba1") {
                        bat '''
                            docker-compose up -d
                            for /f %%i in ('docker ps -qf "name=^devops-laba1-web-1"') do set containerId=%%i
                            echo %containerId%
                            IF "%containerId%" == "" (
                                echo "No container running"
                            )
                            ELSE (
                                docker logs --tail 1000 -f %containerId%
                                )
                        '''
                    }
            }
        }

        stage('Checkout coverage report'){
            steps{
                dir("devops-laba1"){
                    bat '''
                    docker-compose logs -t --tail 10
                    '''
                }
            }
        }

        stage('Push'){
            steps{
                bat 'chcp 65001 && docker push nikita123orange/devops-laba1:latest'
            }
        }

        stage('Sign image with Cosign') {
            steps {
                bat 'cosign sign --key cosign.key nikita123orange/devops-laba1:latest'
            }
        }

        stage('Generate DevSecOps artifact') {
            steps {
                dir("devops-laba1") {
                    script {
                        // 1. Получить хэши последних 5 коммитов
                        def commits = bat(script: 'git log -5 --format="%%H"', returnStdout: true).trim().split('\n')
                        // 2. Получить digest образа (после пуша)
                        def digest = bat(script: 'docker inspect nikita123orange/devops-laba1:latest --format="{{.RepoDigests}}"', returnStdout: true).trim()
                        // 3. (Опционально) Получить coverage, если есть файл
                        def coverage = "N/A"
                        if (fileExists('coverage.json')) {
                            coverage = bat(script: 'powershell -Command "(Get-Content coverage.json | ConvertFrom-Json).totals.percent_covered_display"', returnStdout: true).trim()
                        }
                        // 4. Сформировать YAML
                        writeFile file: 'dev_sec_ops.yml', text: """
        version: "1.0"
        generated_at: "${new Date().toISOString()}"
        docker_image:
        name: "nikita123orange/devops-laba1:latest"
        digest: ${digest}
        code_commits:
        last_5_hashes:
            - ${commits.join('\n    - ')}
        test_coverage:
        percent: ${coverage}
        """
                        // 5. Сохранить как артефакт (опционально)
                        archiveArtifacts artifacts: 'dev_sec_ops.yml'
                    }
                }
            }
        }
	}

    post {
        always {
            node('windows') {
                bat 'chcp 65001 && docker logout'
            }
        }
    }
}
